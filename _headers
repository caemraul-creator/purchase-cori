# =======================================================
# CLOUDFLARE PAGES / NETLIFY HEADERS CONFIGURATION
# Production-Ready Security & Performance Headers
# =======================================================

# ===== GLOBAL HEADERS (Apply to all paths) =====
/*
  # Security Headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  
  # Force HTTPS (HSTS) - 1 year + subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Content Security Policy (CSP) - CRITICAL FOR SECURITY!
  # Sesuaikan dengan kebutuhan aplikasi Anda
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://script.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://script.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  
  # CORS - Restricted (hanya untuk domain Anda sendiri)
  # Ganti * dengan domain spesifik jika perlu lebih ketat
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS, HEAD
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With
  Access-Control-Max-Age: 86400
  
  # Default Cache (short TTL)
  Cache-Control: public, max-age=600, stale-while-revalidate=60


# ===== HTML FILES (No Cache - Always Fresh) =====
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0


# ===== LOGIN PAGE (Extra Strict - Never Cache) =====
/login.html
  Cache-Control: no-cache, no-store, must-revalidate, private
  Pragma: no-cache
  Expires: 0
  X-Robots-Tag: noindex, nofollow


# ===== AUTHENTICATED PAGES (No Cache) =====
/dashboard.html
/index.html
/approval.html
/done.html
/rekap.html
/rejected.html
/print.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache


# ===== JAVASCRIPT FILES =====
/*.js
  Cache-Control: public, max-age=604800, immutable
  X-Content-Type-Options: nosniff
  # 7 days cache (lebih aman dari 1 tahun)
  # Gunakan versioning (?v=1.0.0) atau hash untuk cache busting


# ===== CSS FILES =====
/*.css
  Cache-Control: public, max-age=604800, immutable
  X-Content-Type-Options: nosniff
  # 7 days cache


# ===== IMAGES/LOGOS (Longer Cache OK) =====
/logo.png
/logo.jpg
/logo.jpeg
/logo.svg
/logo.webp
  Cache-Control: public, max-age=2592000, immutable
  # 30 days cache untuk static images


# ===== FONTS (Long Cache OK) =====
/*.woff
/*.woff2
/*.ttf
/*.otf
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *


# ===== API PROXY (if any) =====
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE
  Access-Control-Allow-Headers: Content-Type, Authorization
  Cache-Control: no-cache, no-store, must-revalidate


# ===== MANIFEST & SERVICE WORKER =====
/manifest.json
/sw.js
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json


# ===== ROBOTS & SITEMAP =====
/robots.txt
/sitemap.xml
  Cache-Control: public, max-age=3600
